---
import { getAssetPath } from "@/utils/withBase";

const scenePath = getAssetPath(
  `scenes/${encodeURIComponent("Hoshi Mart — a corner store diorama.html")}`
);
---

<figure class="rainy-corner" aria-label="雨夜街角" data-pagefind-ignore>
  <iframe
    src={scenePath}
    title="Hoshi Mart 互动便利店，香香在店内"
    loading="lazy"
    data-rainy-corner></iframe>
</figure>

<style>
  .rainy-corner {
    margin: 1.25rem 0 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: #141232;
  }
  iframe {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    border: 0;
  }
  @media (max-width: 580px) {
    iframe {
      aspect-ratio: 1;
    }
  }
</style>
