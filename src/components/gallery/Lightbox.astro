---
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";

type Photo = CollectionEntry<"gallery">["data"]["photos"][number];

type Props = {
  photos: Photo[];
};

const { photos } = Astro.props;
const t = useTranslations(Astro.currentLocale);

/** 原图直出地址（已由 Astro 构建为带 base 的静态资源） */
const fullSources = photos.map(photo => photo.src.src);
const captions = photos.map(photo => photo.caption ?? "");
---

<dialog
  id="gallery-lightbox"
  class="m-auto max-h-[92svh] max-w-[92vw] bg-transparent p-0 backdrop:bg-black/90 open:fixed open:inset-0"
  aria-label="Lightbox"
  data-sources={JSON.stringify(fullSources)}
  data-captions={JSON.stringify(captions)}
>
  <div class="relative flex h-full w-full flex-col items-center justify-center">
    <img
      id="lightbox-image"
      src=""
      alt=""
      class="max-h-[80svh] max-w-[92vw] rounded-md object-contain"
    />
    <p
      id="lightbox-caption"
      class="mt-3 min-h-5 px-4 text-center text-sm text-white/85"
    >
    </p>

    <button
      type="button"
      id="lightbox-close"
      class="absolute top-3 right-3 rounded-full bg-white/10 p-2 text-white hover:bg-white/25 focus-visible:outline-2 focus-visible:outline-white"
      aria-label={t.a11y.lightboxClose}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>

    {
      photos.length > 1 && (
        <>
          <button
            type="button"
            id="lightbox-prev"
            class="absolute top-1/2 left-2 -translate-y-1/2 rounded-full bg-white/10 p-2 text-white hover:bg-white/25 focus-visible:outline-2 focus-visible:outline-white"
            aria-label={t.a11y.lightboxPrev}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            id="lightbox-next"
            class="absolute top-1/2 right-2 -translate-y-1/2 rounded-full bg-white/10 p-2 text-white hover:bg-white/25 focus-visible:outline-2 focus-visible:outline-white"
            aria-label={t.a11y.lightboxNext}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </>
      )
    }
  </div>
</dialog>

<script>
  const setupLightbox = () => {
    const dialog = document.getElementById(
      "gallery-lightbox"
    ) as HTMLDialogElement | null;
    const triggers = document.querySelectorAll<HTMLButtonElement>(
      "[data-lightbox-trigger]"
    );
    if (!dialog || triggers.length === 0 || dialog.dataset.lightboxBound)
      return;
    dialog.dataset.lightboxBound = "1";

    const image = dialog.querySelector<HTMLImageElement>("#lightbox-image")!;
    const caption = dialog.querySelector<HTMLElement>("#lightbox-caption")!;
    const prevButton =
      dialog.querySelector<HTMLButtonElement>("#lightbox-prev");
    const nextButton =
      dialog.querySelector<HTMLButtonElement>("#lightbox-next");

    const sources = JSON.parse(dialog.dataset.sources ?? "[]") as string[];
    const captions = JSON.parse(dialog.dataset.captions ?? "[]") as string[];

    let current = 0;

    const show = (index: number) => {
      current = (index + sources.length) % sources.length;
      image.src = sources[current];
      image.alt = captions[current];
      caption.textContent = captions[current];
      // 预加载相邻两张，翻页时无需等待
      for (const offset of [1, -1]) {
        const neighbor =
          sources[(current + offset + sources.length) % sources.length];
        if (neighbor && !preloaded.has(neighbor)) {
          preloaded.add(neighbor);
          new Image().src = neighbor;
        }
      }
    };

    const preloaded = new Set<string>([sources[0]]);

    triggers.forEach(trigger => {
      trigger.addEventListener("click", () => {
        show(Number(trigger.dataset.index ?? 0));
        dialog.showModal();
      });
    });

    dialog
      .querySelector("#lightbox-close")
      ?.addEventListener("click", () => dialog.close());
    prevButton?.addEventListener("click", () => show(current - 1));
    nextButton?.addEventListener("click", () => show(current + 1));

    // 点击遮罩（图片以外的 dialog 自身区域）关闭
    dialog.addEventListener("click", event => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", event => {
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });

    // 关闭后停止加载大图，避免后台继续下载
    dialog.addEventListener("close", () => {
      image.src = "";
    });
  };

  setupLightbox();
  document.addEventListener("astro:page-load", setupLightbox);
</script>
