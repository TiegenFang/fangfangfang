---
import { getImage } from "astro:assets";
import gate from "@/assets/garden/gate-key.png";
import cat from "@/assets/garden/cat-key.png";
import trees from "@/assets/garden/trees-key.png";
import still from "@/assets/garden/poster.png";
import plaque from "@/assets/garden/plaque.svg?url";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import type { GardenRecommendation } from "@/types/home";

interface Props {
  recommendations?: GardenRecommendation[];
}
const { recommendations = [] } = Astro.props;
const discovery = recommendations.map(
  ({ title, description, href, category }) => ({
    title,
    description,
    href,
    category,
  })
);
const [gateImage, catImage, treesImage, poster] = await Promise.all([
  getImage({ src: gate, width: 1100, format: "webp", quality: 95 }),
  getImage({ src: cat, width: 1200, format: "webp", quality: 95 }),
  getImage({ src: trees, width: 1000, format: "webp", quality: 95 }),
  getImage({ src: still, width: 1200, format: "webp", quality: 85 }),
]);
---

<figure
  class="garden"
  aria-label="方寸小院"
  data-garden-figure
  data-recommendations={JSON.stringify(discovery)}
  data-pagefind-ignore
>
  <div
    class="garden-stage"
    data-garden
    data-gate={gateImage.src}
    data-cat={catImage.src}
    data-trees={treesImage.src}
    data-plaque={plaque}
  >
    <div
      class="garden-visual"
      role="img"
      aria-label="透过粉墙灰瓦的景窗，树木掩映着二校门，香香卧在前方石地上。"
    >
      <img
        class="garden-still"
        src={poster.src}
        alt=""
        width={poster.attributes.width}
        height={poster.attributes.height}
        aria-hidden="true"
      />
      <canvas aria-hidden="true"></canvas>
    </div>
    <button
      type="button"
      class="garden-feed"
      data-feed-cat
      aria-describedby="cat-response"
      hidden
    >
      <span class="feed-label"
        >给香香一根猫条 <span aria-hidden="true">＋</span></span
      >
    </button>
    <span class="garden-treat" aria-hidden="true">
      <svg width="48" height="18" viewBox="0 0 48 18" fill="none">
        <path
          d="M4 5h32l8 4-8 4H4z"
          fill="#b58265"
          stroke="#775740"
          stroke-width="1.5"></path>
        <path d="M12 6v6m14-6v6" stroke="#e8d5a6" stroke-width="2"></path>
      </svg>
    </span>
  </div>
  <figcaption>
    <p
      id="cat-response"
      class="cat-response"
      data-cat-response
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      香香在晒太阳。
    </p>
    <div class="garden-actions">
      <button
        type="button"
        class="wander-button"
        data-wander
        aria-controls="garden-recommendation"
        aria-expanded="false"
        hidden
      >
        带我随便逛逛 <IconArrowRight
          width={17}
          height={17}
          aria-hidden="true"
        />
      </button>
      <noscript>
        {
          recommendations.length > 0 && (
            <a class="wander-button" href="#featured">
              去看看精选内容
              <IconArrowRight width={17} height={17} aria-hidden="true" />
            </a>
          )
        }
      </noscript>
    </div>
  </figcaption>
  <div
    id="garden-recommendation"
    class="garden-result"
    data-garden-result
    aria-labelledby="garden-result-title"
    hidden
  >
    <p class="result-category" data-result-category></p>
    <h3 id="garden-result-title" data-result-title></h3>
    <p class="result-description" data-result-description></p>
    <a class="result-link" data-result-link
      >去看看 <IconArrowRight width={16} height={16} aria-hidden="true" /></a
    >
  </div>
  <p
    class="sr-only"
    data-recommendation-status
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
  </p>
</figure>

<script>
  import { mountGarden } from "@/scripts/garden-scene";
  import { mountGardenInteractions } from "@/scripts/garden-interactions";

  let cleanup: (() => void) | undefined;
  let activeGarden: HTMLElement | undefined;
  const mount = () => {
    const garden = document.querySelector<HTMLElement>("[data-garden-figure]");
    if (garden === activeGarden) return;
    cleanup?.();
    activeGarden = garden ?? undefined;
    if (!garden) return;
    const releaseControls = mountGardenInteractions(garden);
    const releaseScene = mountGarden(
      garden.querySelector<HTMLElement>("[data-garden]")!
    );
    cleanup = () => {
      releaseControls();
      releaseScene();
    };
  };
  document.addEventListener("astro:page-load", mount);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
    activeGarden = undefined;
  });
  mount();
</script>

<style>
  .garden {
    margin: 0.5rem -0.5rem 0;
  }
  .garden [hidden] {
    display: none !important;
  }
  .garden-stage {
    position: relative;
    aspect-ratio: 1.95;
    touch-action: pan-y;
  }
  .garden-visual,
  canvas,
  .garden-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .garden-still {
    object-fit: contain;
  }
  canvas {
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .garden-stage[data-ready] canvas {
    opacity: 1;
  }
  .garden-stage[data-ready] .garden-still {
    visibility: hidden;
  }
  :global([data-theme="dark"]) .garden-visual {
    filter: brightness(0.82) saturate(0.85);
  }
  .garden-feed {
    position: absolute;
    left: 57%;
    top: 43%;
    width: 30%;
    height: 44%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    border-radius: 1rem;
    background: transparent;
    padding-bottom: 0.4rem;
  }
  .feed-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 0.75rem;
    background: var(--background);
    color: var(--accent);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 2px 8px #252a2610;
  }
  .garden-feed:hover .feed-label {
    border-color: var(--accent);
  }
  .garden-treat {
    position: absolute;
    top: 55%;
    left: 69%;
    opacity: 0;
    pointer-events: none;
  }
  .garden[data-feeding] .garden-treat {
    animation: deliver-treat 850ms ease-out both;
  }
  @keyframes deliver-treat {
    0% {
      opacity: 0;
      transform: translate(2rem, 1rem) rotate(-15deg);
    }
    25%,
    60% {
      opacity: 1;
      transform: translate(0, 0) rotate(-10deg);
    }
    100% {
      opacity: 0;
      transform: translate(-0.5rem, -0.25rem) scale(0.85);
    }
  }
  figcaption {
    text-align: center;
  }
  .cat-response {
    min-height: 1.75rem;
    padding: 0 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.75;
  }
  .garden-actions {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .wander-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 3rem;
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--accent);
    border-radius: 0.35rem;
    color: var(--accent);
    background: transparent;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .wander-button:hover {
    background: var(--muted);
  }
  .garden-result {
    max-width: 32rem;
    margin: 1.25rem auto 0;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0.2rem;
    text-align: left;
  }
  .result-category {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .garden-result h3 {
    margin-top: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .result-description {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.85;
  }
  .result-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.4rem;
    color: var(--accent);
    font-size: 0.875rem;
  }
  .result-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  @media (max-width: 480px) {
    .garden {
      margin-inline: -0.6rem;
    }
    .garden-stage {
      aspect-ratio: 1.8;
    }
    .garden-feed {
      left: 55%;
      width: 34%;
    }
    .feed-label {
      padding: 0.5rem 0.6rem;
      font-size: 0.7rem;
    }
    .garden-result {
      margin-inline: 0.6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    canvas {
      transition: none;
    }
    .garden[data-feeding] .garden-treat {
      animation: none;
    }
  }
</style>
