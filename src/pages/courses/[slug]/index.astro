---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getCourseLectures } from "@/utils/getCourseLectures";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const courses = await getCollection("courses", ({ data }) => !data.draft);
  return courses.map(course => ({
    params: { slug: course.id },
    props: { course },
  }));
}

type Props = { course: CollectionEntry<"courses"> };

const { course } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const allPosts = await getCollection("posts");
const lectures = getCourseLectures(allPosts, course.id);

const { Content } = await render(course);
---

<Layout
  title={`${course.data.title} | ${config.site.title}`}
  description={course.data.description}
  canonicalURL={course.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={course.data.title}
    pageDesc={course.data.description}
    class="app-prose"
    data-pagefind-body
  >
    <Content />

    <h2>{t.course.lecturesTitle}</h2>

    <p>{tplStr(t.course.lecturesCount, { count: lectures.length })}</p>

    {lectures.length === 0 && <p>{t.course.empty}</p>}

    <ol class="not-prose mt-4 mb-8 list-none ps-0">
      {
        lectures.map((lecture, index) => (
          <li class="border-border my-4 border-b pb-4">
            <span class="text-muted-foreground me-2 text-sm whitespace-nowrap">
              {tplStr(t.course.lecturePrefix, { index: index + 1 })}
            </span>
            <a
              href={getPostUrl(lecture.id, lecture.filePath, locale)}
              class:list={[
                "text-accent inline-block font-medium",
                "decoration-dashed underline-offset-4 hover:underline",
              ]}
            >
              {lecture.data.title}
            </a>
            <p class="text-muted-foreground mt-1 text-sm">
              {lecture.data.description}
            </p>
            <Datetime
              pubDatetime={lecture.data.pubDatetime}
              modDatetime={lecture.data.modDatetime}
              timezone={lecture.data.timezone}
              class="mt-1"
            />
          </li>
        ))
      }
    </ol>

    <LinkButton href={getRelativeLocaleUrl(locale, "courses")}>
      {t.course.backToCourses}
    </LinkButton>
  </Main>

  <Footer />
</Layout>
