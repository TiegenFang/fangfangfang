---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getCourseLectures } from "@/utils/getCourseLectures";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const allPosts = await getCollection("posts");
const courses = (await getCollection("courses", ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  )
  .map(course => ({
    course,
    lectureCount: getCourseLectures(allPosts, course.id).length,
  }));
---

<Layout title={`${t.pages.coursesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.coursesTitle} pageDesc={t.pages.coursesDesc}>
    <ul>
      {
        courses.map(({ course, lectureCount }) => (
          <li class="my-6">
            <a
              href={getRelativeLocaleUrl(locale, `courses/${course.id}`)}
              class:list={[
                "text-accent inline-block text-lg font-medium",
                "decoration-dashed underline-offset-4 hover:underline",
                "focus-visible:no-underline focus-visible:underline-offset-0",
              ]}
            >
              <h2 class="inline-block">{course.data.title}</h2>
            </a>
            <p class="text-muted-foreground mt-1 text-sm">
              {tplStr(t.course.lecturesCount, { count: lectureCount })}
            </p>
            <p>{course.data.description}</p>
          </li>
        ))
      }
    </ul>
  </Main>

  <div class="app-layout my-8 text-center">
    <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
      {t.home.allPosts}
      <IconArrowRight class="inline-block rtl:-rotate-180" />
    </LinkButton>
  </div>

  <Footer />
</Layout>
