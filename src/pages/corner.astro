---
import Layout from "@/layouts/Layout.astro";
import CornerLoader from "@/components/CornerLoader.astro";
import { getAssetPath } from "@/utils/withBase";
const scenePath = getAssetPath(
  `scenes/${encodeURIComponent("Hoshi Mart — a corner store diorama.html")}`
);
---

<Layout title="香香的便利店 · 方寸之间" bodyClass="corner-page">
  <CornerLoader active />
  <iframe
    class="corner-scene"
    src={scenePath}
    title="Hoshi Mart 互动便利店，香香在店内"
    inert
    data-corner-scene></iframe>
</Layout>

<script>
  import { mountCornerScene } from "@/scripts/corner-entry";
  let cleanup: (() => void) | undefined;
  function mount() {
    cleanup?.();
    cleanup = mountCornerScene();
  }
  document.addEventListener("astro:page-load", mount);
  document.addEventListener("astro:before-swap", () => cleanup?.());
  mount();
</script>

<style>
  .corner-scene {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #141232;
  }
</style>

<style is:global>
  html:has(body.corner-page) {
    overflow: hidden;
  }
</style>
