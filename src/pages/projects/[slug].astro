---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const { title, description, category, status, repo, tags } = project.data;
const { Content } = await render(project);

const statusLabels = {
  Active: t.project.statusActive,
  Completed: t.project.statusCompleted,
  Paused: t.project.statusPaused,
  Archived: t.project.statusArchived,
} as const;
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />

  <main
    id="main-content"
    class="wide-layout pb-4"
    data-pagefind-body
    data-backUrl={getRelativeLocaleUrl(locale, "projects")}
  >
    <a
      href={getRelativeLocaleUrl(locale, "projects")}
      class="text-muted-foreground hover:text-accent block w-fit pt-6 text-sm transition-colors"
    >
      ← {t.nav.projects}
    </a>

    <h1 class="text-accent mt-4 inline-block text-2xl font-bold sm:text-3xl">
      {title}
    </h1>

    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="font-mono text-xs tracking-widest uppercase">
        {category}
      </span>
      <span
        class="border-border text-muted-foreground rounded-md border px-2 py-0.5 text-xs"
      >
        {statusLabels[status]}
      </span>
      <Datetime pubDatetime={project.data.pubDatetime} />
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent ms-auto text-sm decoration-dashed underline-offset-4 hover:underline"
          >
            {t.project.repoLink} ↗
          </a>
        )
      }
    </div>

    <article class="app-prose max-w-app mx-auto mt-8">
      <Content />
    </article>

    {
      tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2 border-t border-dashed pt-6">
          {tags.map(tag => (
            <li class="text-muted-foreground bg-muted/40 rounded-md px-2 py-1 text-xs">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </main>

  <Footer />
</Layout>
