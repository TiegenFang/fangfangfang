---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import AlbumCard from "@/components/gallery/AlbumCard.astro";
import AlbumGrid from "@/components/gallery/AlbumGrid.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const albums = (await getCollection("gallery", ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout
  title={`${t.pages.galleryTitle} | ${config.site.title}`}
  description={t.pages.galleryDesc}
>
  <Header />

  <Main wide pageTitle={t.pages.galleryTitle} pageDesc={t.pages.galleryDesc}>
    {
      albums.length > 0 ? (
        <AlbumGrid class="mt-2">
          {albums.map(album => (
            <AlbumCard {...album} />
          ))}
        </AlbumGrid>
      ) : (
        <p class="text-muted-foreground mt-8">{t.gallery.empty}</p>
      )
    }
  </Main>

  <Footer />
</Layout>
