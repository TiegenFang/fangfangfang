---
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  prevPost: CollectionEntry<"posts"> | null;
  nextPost: CollectionEntry<"posts"> | null;
  /** Lecture mode: labels switch to course-scoped prev/next lecture. */
  isLecture?: boolean;
};

const { prevPost, nextPost, isLecture = false } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const previousLabel = isLecture
  ? t.course.previousLecture
  : t.post.previousPost;
const nextLabel = isLecture ? t.course.nextLecture : t.post.nextPost;
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="flex w-full gap-1 hover:opacity-75"
      >
        <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
        <div>
          <span>{previousLabel}</span>
          <div class="text-accent/85 text-sm">{prevPost.data.title}</div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
      >
        <div>
          <span>{nextLabel}</span>
          <div class="text-accent/85 text-sm">{nextPost.data.title}</div>
        </div>
        <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
      </a>
    )
  }
</div>
