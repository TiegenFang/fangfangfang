---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import GardenScene from "@/components/GardenScene.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const courses = (
  await getCollection("courses", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    new Date(b.data.pubDatetime).getTime() -
    new Date(a.data.pubDatetime).getTime()
);

const allPostsForLectures = await getCollection("posts", postFilter);
const courseShortNames = new Map(
  courses.map(course => [
    course.id,
    course.data.shortTitle ?? course.data.title,
  ])
);
const courseLectureCount = new Map<string, number>();
for (const post of allPostsForLectures) {
  if (post.data.course) {
    courseLectureCount.set(
      post.data.course,
      (courseLectureCount.get(post.data.course) ?? 0) + 1
    );
  }
}
const withCourseBadge = ({ data }: (typeof sortedPosts)[number]) =>
  data.course ? courseShortNames.get(data.course) : undefined;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-6 pb-4">
      <h1
        class="mt-3 mb-3 inline-block text-4xl font-bold sm:mt-5 sm:mb-4 sm:text-5xl"
      >
        你好，我是 Tiegen Fang
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="text-muted-foreground">
        记录课程、科研与计算，以及实验室之外的碎碎念。
      </p>
      <p class="mt-2">欢迎来到「方寸之间」。方寸之间，自有天地。</p>
      {
        socials.length > 0 && (
          <div class="mt-3 flex max-sm:flex-col sm:items-center">
            <div class="me-2 whitespace-nowrap">{t.home.socialLinks}:</div>
            <Socials />
          </div>
        )
      }
      <GardenScene />
    </section>

    {
      courses.length > 0 && (
        <section id="courses" class="border-border border-b pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">{t.nav.courses}</h2>
          <ul>
            {courses.map(course => (
              <li class="my-6">
                <a
                  href={getRelativeLocaleUrl(locale, `courses/${course.id}`)}
                  class:list={[
                    "text-accent inline-block text-lg font-medium",
                    "decoration-dashed underline-offset-4 hover:underline",
                    "focus-visible:no-underline focus-visible:underline-offset-0",
                  ]}
                >
                  <h3 class="inline-block">{course.data.title}</h3>
                </a>
                <span class="text-muted-foreground ms-2 text-sm">
                  {tplStr(t.course.lecturesCount, {
                    count: courseLectureCount.get(course.id) ?? 0,
                  })}
                </span>
                <p>{course.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" badge={withCourseBadge(data)} {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" badge={withCourseBadge(data)} {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
